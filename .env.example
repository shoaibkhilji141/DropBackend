# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# On Render only: forward eBay/AliExpress OAuth callbacks to the local API.
# OAUTH_CALLBACK_FORWARD=http://localhost:3000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (Prisma / SQLite)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional model override; defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# eBay
# ---------------------------------------------------------------------------
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
EBAY_CLIENT_SECRET=
# HTTPS callback registered on the RuName (not sent as OAuth redirect_uri).
EBAY_REDIRECT_URI=https://your-host/api/connections/ebay/callback
# RuName from eBay Developer Portal → User Tokens. Required for OAuth.
EBAY_RU_NAME=
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# AliExpress
# ---------------------------------------------------------------------------
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Auth0
# ---------------------------------------------------------------------------
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# ---------------------------------------------------------------------------
# Redis (BullMQ)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to true once a Redis instance is running on REDIS_HOST:REDIS_PORT.
REDIS_ENABLED=true
