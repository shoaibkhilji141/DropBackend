{
  "name": "@elbaflabs/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend for the dropshipping management application",
  "scripts": {
    "build": "nest build",
    "start": "prisma migrate deploy && node dist/main.js",
