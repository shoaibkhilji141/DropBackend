generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & stores
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  auth0Id   String?  @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores               Store[]
  products             Product[]
  aiRequests           AIRequest[]
  alerts               Alert[]
  integrationAccounts  IntegrationAccount[]
}

/// A marketplace account the seller sells through (currently eBay only).
model Store {
  id        String      @id @default(cuid())
  userId    String
  name      String
  platform  Platform    @default(EBAY)
  status    LinkStatus  @default(DISCONNECTED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]
  orders   Order[]

  @@index([userId])
}

/// A source the products are bought from (currently AliExpress only).
model Supplier {
  id         String     @id @default(cuid())
  name       String
  platform   Platform   @default(ALIEXPRESS)
  externalId String?    @unique
  /// Supplier reputation score reported by the source marketplace, 0-100.
  score      Float?
  status     LinkStatus @default(DISCONNECTED)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  products Product[]

  @@index([platform])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id           String        @id @default(cuid())
  userId       String
  supplierId   String?
  externalId   String?
  title        String
  description  String?
  imageUrl     String?
  /// Additional gallery images, stored as a JSON string array (SQLite has no array type).
  images       String?
  sourceUrl    String?
  category     String?
  currency     String        @default("USD")
  costPrice    Float         @default(0)
  shippingCost Float         @default(0)
  sellPrice    Float         @default(0)
  stock        Int           @default(0)
  rating       Float?
  ordersCount  Int?
  reviews      Int?
  shippingMethod  String?
  shippingEtaDays Int?
  status       ProductStatus @default(SAVED)
  importedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  variants        ProductVariant[]
  listings        Listing[]
  priceHistory    PriceHistory[]
  stockHistory    StockHistory[]
  shippingHistory ShippingHistory[]
  monitoringRules MonitoringRule[]
  profitRecords   ProfitRecord[]
  alerts          Alert[]
  orderItems      OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([externalId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  externalId String?
  sku        String?
  name       String
  attributes String?
  imageUrl   String?
  costPrice  Float    @default(0)
  sellPrice  Float    @default(0)
  stock      Int      @default(0)
  /// Whether the variant is included when importing and listing the product.
  selected   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Listings & orders
// ---------------------------------------------------------------------------

model Listing {
  id            String        @id @default(cuid())
  productId     String
  storeId       String?
  externalId    String?
  title         String
  description   String?
  /// Gallery images stored as a JSON string array.
  images        String?
  category      String?
  sku           String?
  price         Float         @default(0)
  quantity      Int           @default(0)
  shippingMethod  String?
  shippingCost    Float       @default(0)
  shippingEtaDays Int?
  /// Selected product variant ids, stored as a JSON string array.
  selectedVariantIds String?
  status        ListingStatus @default(DRAFT)
  publishedAt   DateTime?
  offerId       String?
  lastError     String?
  autoUpdateEnabled Boolean   @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@index([productId])
  @@index([status])
}

model Order {
  id           String      @id @default(cuid())
  storeId      String?
  externalId   String?
  buyerName    String?
  buyerEmail   String?
  buyerAddress String?
  buyerCity    String?
  buyerCountry String?
  status       OrderStatus @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency     String      @default("USD")
  totalAmount  Float       @default(0)
  supplierCost Float       @default(0)
  shippingCost Float       @default(0)
  trackingCode String?
  trackingCarrier String?
  /// eBay line-item ids used when pushing tracking, stored as JSON.
  lineItemData String?
  lastError    String?
  shippedAt    DateTime?
  placedAt     DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  items         OrderItem[]
  profitRecords ProfitRecord[]

  @@index([storeId])
  @@index([status])
  @@index([fulfillmentStatus])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  listingId String?
  title     String
  quantity  Int      @default(1)
  unitPrice Float    @default(0)
  unitCost  Float    @default(0)
  createdAt DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Monitoring history
// ---------------------------------------------------------------------------

model PriceHistory {
  id            String   @id @default(cuid())
  productId     String
  price         Float
  previousPrice Float?
  currency      String   @default("USD")
  recordedAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
}

model StockHistory {
  id            String   @id @default(cuid())
  productId     String
  stock         Int
  previousStock Int?
  recordedAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
}

model ShippingHistory {
  id              String   @id @default(cuid())
  productId       String
  method          String
  cost            Float
  etaDays         Int?
  previousMethod  String?
  previousCost    Float?
  available       Boolean  @default(true)
  recordedAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
}

model MonitoringRule {
  id              String         @id @default(cuid())
  productId       String
  type            MonitoringType
  threshold       Float?
  /// How often the rule is checked, in minutes.
  intervalMinutes Int            @default(15)
  enabled         Boolean        @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastError       String?
  lastStatus      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type])
  @@index([enabled, nextRunAt])
}

// ---------------------------------------------------------------------------
// Profit, AI and alerts
// ---------------------------------------------------------------------------

model ProfitRecord {
  id           String     @id @default(cuid())
  productId    String?
  orderId      String?
  type         ProfitType @default(ESTIMATED)
  revenue      Float      @default(0)
  cost         Float      @default(0)
  fees         Float      @default(0)
  shippingCost Float      @default(0)
  profit       Float      @default(0)
  margin       Float      @default(0)
  currency     String     @default("USD")
  recordedAt   DateTime   @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([orderId])
}

/// Singleton row of configurable marketplace fee defaults used by ProfitService.
model ProfitSetting {
  id                      String   @id @default("default")
  marketplaceFeePercent   Float    @default(12.9)
  paymentFeePercent       Float    @default(2.9)
  fixedFee                Float    @default(0.3)
  additionalCosts         Float    @default(0)
  defaultMarkupMultiplier Float    @default(2.6)
  currency                String   @default("USD")
  updatedAt               DateTime @updatedAt
}

model AIRequest {
  id         String        @id @default(cuid())
  userId     String?
  type       AIRequestType
  prompt     String
  response   String?
  model      String?
  tokensUsed Int?
  status     AIStatus      @default(PENDING)
  createdAt  DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Alert {
  id        String        @id @default(cuid())
  userId    String?
  productId String?
  type      AlertType
  severity  AlertSeverity @default(INFO)
  message   String
  readAt    DateTime?
  createdAt DateTime      @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Enums (SQLite stores these as strings)
// ---------------------------------------------------------------------------

/// Per-user OAuth tokens for eBay / AliExpress. Tokens are never returned by the API.
model IntegrationAccount {
  id             String     @id @default(cuid())
  userId         String
  platform       Platform
  status         LinkStatus @default(DISCONNECTED)
  externalUserId String?
  displayName    String?
  accountEmail   String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String?
  marketplaceId  String?
  lastError      String?
  lastSyncedAt   DateTime?
  /// JSON string array of official API methods confirmed available.
  capabilities   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([platform, status])
}

enum Platform {
  EBAY
  ALIEXPRESS
}

enum LinkStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum ProductStatus {
  SAVED
  IMPORTED
  LISTED
  ARCHIVED
}

enum ListingStatus {
  DRAFT
  READY
  PUBLISHED
  PAUSED
  ENDED
  ERROR
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
}

enum MonitoringType {
  PRICE
  STOCK
  SHIPPING
}

enum ProfitType {
  ESTIMATED
  ACTUAL
}

enum AIRequestType {
  TITLE
  DESCRIPTION
  IMPROVE_DESCRIPTION
  KEYWORDS
  HIGHLIGHTS
}

enum AIStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AlertType {
  PRICE_CHANGE
  PRICE_INCREASE
  PRICE_DECREASE
  STOCK_CHANGE
  OUT_OF_STOCK
  BACK_IN_STOCK
  SHIPPING_CHANGE
  SHIPPING_UNAVAILABLE
  SHIPPING_COST_CHANGE
  SYSTEM
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}
